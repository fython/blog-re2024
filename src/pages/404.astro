---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout my-8 flex flex-1 items-center justify-center"
  >
    <div class="mb-12 flex flex-col items-center justify-center text-center">
      <span
        class="text-secondary mb-2 text-xs font-medium tracking-[0.2em] uppercase"
      >
        Page Not Found
      </span>
      <h1 class="text-foreground font-serif text-7xl font-bold sm:text-8xl">
        404
      </h1>
      <div aria-hidden="true" class="bg-accent my-5 h-[2px] w-12"></div>
      <p class="text-muted-foreground text-base sm:text-lg">
        {t.notFound.message}
      </p>
      <LinkButton
        href={getRelativeLocaleUrl(locale, "")}
        class="border-border bg-background text-foreground hover:border-accent hover:bg-surface hover:text-accent mt-7 inline-flex min-h-10 items-center rounded-sm border px-5 py-2 text-sm font-medium transition-colors"
      >
        {t.notFound.goHome}
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
