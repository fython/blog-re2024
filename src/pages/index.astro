---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PaintWidget from "@/components/PaintWidget.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import config from "@/config";

const posts = await getCollection("posts");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <div class="home-layout">
    <aside class="home-sidebar" aria-label="站点介绍与导航">
      <Header sidebar />
      <div id="paint-area" class="app-layout pt-8 pb-6">
        <PaintWidget />
      </div>
    </aside>
    <main id="main-content" data-layout="index" class="app-layout home-posts">
      <h1 class="sr-only">{config.site.title}</h1>
      <div class="home-intro-divider"><Hr /></div>

      {
        featuredPosts.length > 0 && (
          <>
            <section id="featured" class="pt-12 pb-6">
              <h2 class="text-2xl font-semibold tracking-wide">精选</h2>
              <ul>
                {featuredPosts.map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </section>
            {recentPosts.length > 0 && <Hr />}
          </>
        )
      }

      {
        recentPosts.length > 0 && (
          <section id="recent-posts" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">最近填坑</h2>
            <ul>
              {recentPosts.map(
                (data, index) =>
                  index < config.posts.perIndex && (
                    <Card variant="h3" {...data} />
                  )
              )}
            </ul>
          </section>
        )
      }

      <div class="my-8 text-center">
        <LinkButton href="/posts/">
          所有文章
          <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>
    </main>
  </div>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

<style>
  .home-layout {
    width: 100%;
  }

  @media (min-width: 66rem) {
    .home-layout {
      display: grid;
      grid-template-columns: 19rem minmax(0, 46rem);
      column-gap: 2rem;
      max-width: 71rem;
      margin-inline: auto;
      padding: 3rem 2rem 2rem;
      align-items: start;
    }

    .home-sidebar {
      min-width: 0;
    }

    #paint-area {
      padding: 2rem 0 0;
      border-top: 1px solid var(--border);
    }

    .home-posts {
      min-width: 0;
      padding: 0 0 0 2rem;
      border-left: 1px solid var(--border);
    }

    .home-posts > section:first-of-type {
      padding-top: 0;
    }

    .home-intro-divider {
      display: none;
    }
  }

  @media (min-width: 66rem) and (min-height: 50rem) {
    .home-sidebar {
      position: sticky;
      top: 2rem;
    }
  }
</style>
