---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SidebarVisual from "@/components/SidebarVisual.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import config from "@/config";

const posts = await getCollection("posts");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <div class="home-layout">
    <aside class="home-sidebar" aria-label="站点介绍与导航">
      <Header sidebar />
      <div class="sidebar-visual-slot app-layout pt-5 pb-1 sm:pt-6">
        <SidebarVisual />
      </div>
    </aside>

    <main id="main-content" data-layout="index" class="app-layout home-posts">
      <h1 class="sr-only">{config.site.title}</h1>

      {
        featuredPosts.length > 0 && (
          <section id="featured" class="pt-5 pb-4 sm:pt-7">
            <div class="border-border mb-2 border-b pb-3">
              <h2 class="text-foreground font-serif text-xl font-bold tracking-wide sm:text-2xl">
                精选
              </h2>
            </div>
            <ul class="divide-border divide-y">
              {featuredPosts.map(data => (
                <Card variant="h3" featuredBadge {...data} />
              ))}
            </ul>
          </section>
        )
      }

      {
        recentPosts.length > 0 && (
          <section id="recent-posts" class="pt-8 pb-4 sm:pt-10">
            <div class="border-border mb-2 border-b pb-3">
              <h2 class="text-foreground font-serif text-xl font-bold tracking-wide sm:text-2xl">
                最近填坑
              </h2>
            </div>
            <ul class="divide-border divide-y">
              {recentPosts.map(
                (data, index) =>
                  index < config.posts.perIndex && (
                    <Card variant="h3" {...data} />
                  )
              )}
            </ul>
          </section>
        )
      }

      <div class="my-10 flex justify-center sm:justify-start">
        <LinkButton
          href="/posts/"
          class="border-border bg-background text-foreground hover:border-accent hover:bg-surface hover:text-accent inline-flex min-h-10 items-center gap-2 rounded-sm border px-5 py-2 text-sm font-medium transition-colors"
        >
          <span>查看所有文章</span>
          <IconArrowRight class="inline-block size-4" />
        </LinkButton>
      </div>
    </main>
  </div>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>

<style>
  .home-layout {
    width: 100%;
  }

  @media (min-width: 66rem) {
    .home-layout {
      display: grid;
      grid-template-columns: 18.5rem minmax(0, 46rem);
      column-gap: 2.5rem;
      max-width: 71rem;
      margin-inline: auto;
      padding: 3.25rem 2rem 2rem;
      align-items: start;
    }

    .home-sidebar {
      min-width: 0;
    }

    .sidebar-visual-slot {
      max-width: none;
      padding: 1.75rem 0 0;
      border-top: 1px solid var(--border);
    }

    .home-posts {
      min-width: 0;
      padding: 0 0 0 2.5rem;
      border-left: 1px solid var(--border);
    }

    .home-posts > section:first-of-type {
      padding-top: 0;
    }
  }

  @media (min-width: 66rem) and (min-height: 48rem) {
    .home-sidebar {
      position: sticky;
      top: 2.5rem;
    }
  }
</style>
