---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<nav
  aria-label="相邻文章导航"
  data-pagefind-ignore
  class="my-8 grid grid-cols-1 gap-4 sm:grid-cols-2"
>
  {prevPost && (
    <a
      href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
      class="group border-border bg-background hover:border-accent hover:bg-surface flex w-full flex-col gap-1.5 rounded-sm border p-4 transition-colors"
    >
      <span class="text-muted-foreground inline-flex items-center gap-1 text-xs">
        <IconArrowLeft class="inline-block size-3.5 shrink-0 rtl:rotate-180" />
        <span>{t.post.previousPost}</span>
      </span>
      <div class="text-foreground group-hover:text-accent font-serif text-sm leading-snug font-semibold transition-colors sm:text-[0.9375rem]">
        {prevPost.title}
      </div>
    </a>
  )}
  {nextPost && (
    <a
      href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
      class="group border-border bg-background hover:border-accent hover:bg-surface flex w-full flex-col items-end gap-1.5 rounded-sm border p-4 text-end transition-colors sm:col-start-2"
    >
      <span class="text-muted-foreground inline-flex items-center gap-1 text-xs">
        <span>{t.post.nextPost}</span>
        <IconArrowRight class="inline-block size-3.5 shrink-0 rtl:rotate-180" />
      </span>
      <div class="text-foreground group-hover:text-accent font-serif text-sm leading-snug font-semibold transition-colors sm:text-[0.9375rem]">
        {nextPost.title}
      </div>
    </a>
  )}
</nav>
