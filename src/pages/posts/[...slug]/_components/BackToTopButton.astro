---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowNarrowUp from "@/assets/icons/IconArrowNarrowUp.svg";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

<div
  id="btt-btn-container"
  class:list={[
    "fixed inset-e-4 bottom-6 z-40",
    "md:sticky md:inset-e-auto md:float-end md:me-0",
    "translate-y-10 opacity-0 transition duration-300",
  ]}
>
  <button
    type="button"
    data-button="back-to-top"
    aria-label={t.post.backToTop}
    class:list={[
      "group relative inline-flex items-center justify-center",
      "size-12 rounded-full p-[2px]",
      "md:border-border md:bg-surface md:hover:border-accent md:hover:text-accent md:h-9 md:w-fit md:rounded-sm md:border md:px-3 md:py-1.5 md:transition-colors",
    ]}
  >
    <span
      id="progress-indicator"
      aria-hidden="true"
      class="bg-border absolute inset-0 rounded-full md:hidden"
    ></span>
    <span class="bg-background text-foreground group-hover:text-accent relative z-10 inline-flex size-full items-center justify-center rounded-full transition-colors md:size-auto md:rounded-none md:bg-transparent">
      <IconArrowLeft class="inline-block size-5 rotate-90 md:hidden" />
      <span class="sr-only text-xs font-medium md:not-sr-only md:inline-flex md:items-center md:gap-1">
        <IconArrowNarrowUp class="inline-block size-4" />
        {t.post.backToTop}
      </span>
    </span>
  </button>
</div>

<script is:inline data-astro-rerun>
  function backToTop() {
    const rootElement = document.documentElement;
    const btnContainer = document.querySelector("#btt-btn-container");
    const backToTopBtn = document.querySelector("[data-button='back-to-top']");
    const progressIndicator = document.querySelector("#progress-indicator");

    if (!rootElement || !btnContainer || !backToTopBtn || !progressIndicator)
      return;

    backToTopBtn.addEventListener("click", () => {
      document.body.scrollTop = 0;
      document.documentElement.scrollTop = 0;
    });

    let lastVisible = null;
    function handleScroll() {
      const scrollTotal = rootElement.scrollHeight - rootElement.clientHeight;
      const scrollTop = rootElement.scrollTop;
      const scrollPercent =
        scrollTotal > 0 ? Math.floor((scrollTop / scrollTotal) * 100) : 0;

      progressIndicator.style.setProperty(
        "background-image",
        `conic-gradient(var(--accent) ${scrollPercent}%, var(--border) ${scrollPercent}%)`
      );

      const isVisible = scrollTotal > 0 && scrollTop / scrollTotal > 0.3;

      if (isVisible !== lastVisible) {
        btnContainer.classList.toggle("opacity-100", isVisible);
        btnContainer.classList.toggle("translate-y-0", isVisible);
        btnContainer.classList.toggle("opacity-0", !isVisible);
        btnContainer.classList.toggle("translate-y-10", !isVisible);
        lastVisible = isVisible;
      }
    }

    let ticking = false;
    document.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    });
  }
  backToTop();
</script>
