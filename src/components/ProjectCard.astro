---
export interface Props {
  name: string;
  url?: string;
  description?: string;
  badge?: string;
  badgeTone?: "neutral" | "active";
}

const { name, url, description, badge, badgeTone = "neutral" } = Astro.props;

let displayUrl: string | undefined;
if (url) {
  try {
    const parsed = new URL(url);
    const host = parsed.hostname.replace(/^www\./, "");
    const path = parsed.pathname.replace(/\/+$/, "");
    displayUrl = path && path !== "/" ? `${host}${path}` : host;
  } catch {
    displayUrl = url;
  }
}

const badgeClass =
  badgeTone === "active"
    ? "bg-secondary-soft text-secondary"
    : "border border-border bg-surface text-muted-foreground";
---

<li class="w-full">
  {
    url ? (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="group border-border bg-background hover:border-accent hover:bg-surface flex h-full w-full flex-col justify-between gap-3 rounded-sm border p-4 transition-colors"
      >
        <div class="space-y-1.5">
          <div class="flex items-start justify-between gap-2">
            <h3 class="text-foreground group-hover:text-accent font-serif text-base leading-snug font-bold transition-colors">
              {name}
            </h3>
            {badge && (
              <span
                class:list={[
                  "shrink-0 rounded-sm px-2 py-0.5 text-[0.7rem] font-medium",
                  badgeClass,
                ]}
              >
                {badge}
              </span>
            )}
          </div>
          {description && (
            <p class="text-muted-foreground text-sm leading-relaxed">
              {description}
            </p>
          )}
        </div>
        <div class="text-muted-foreground group-hover:text-accent truncate font-mono text-xs transition-colors">
          {displayUrl} ↗
        </div>
      </a>
    ) : (
      <div class="border-border bg-surface/50 flex h-full w-full flex-col justify-between gap-3 rounded-sm border p-4">
        <div class="space-y-1.5">
          <div class="flex items-start justify-between gap-2">
            <h3 class="text-foreground font-serif text-base leading-snug font-bold">
              {name}
            </h3>
            {badge && (
              <span
                class:list={[
                  "shrink-0 rounded-sm px-2 py-0.5 text-[0.7rem] font-medium",
                  badgeClass,
                ]}
              >
                {badge}
              </span>
            )}
          </div>
          {description && (
            <p class="text-muted-foreground text-sm leading-relaxed">
              {description}
            </p>
          )}
        </div>
        <div class="text-muted-foreground font-mono text-xs">暂未公开链接</div>
      </div>
    )
  }
</li>
