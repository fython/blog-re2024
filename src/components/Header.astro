---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

interface Props {
  sidebar?: boolean;
}

const { sidebar = false } = Astro.props;
const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const navLinks = [
  {
    href: getRelativeLocaleUrl(locale, "posts"),
    label: "posts.",
    path: "/posts",
  },
  {
    href: getRelativeLocaleUrl(locale, "about"),
    label: "about.",
    path: "/about",
  },
  {
    href: getRelativeLocaleUrl(locale, "projects"),
    label: "works.",
    path: "/projects",
  },
  {
    href: getRelativeLocaleUrl(locale, "friends"),
    label: "friends.",
    path: "/friends",
  },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="border-accent bg-background text-accent absolute inset-s-5 -top-full z-50 rounded-sm border px-3 py-2 text-sm font-medium transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class:list={["site-header app-layout", { "home-sidebar-header": sidebar }]}
>
  <div class="header-inner border-border bg-background flex w-full flex-col border-b py-3.5 sm:flex-row sm:items-center sm:justify-between sm:py-5">
    <div class="header-bar flex w-full items-center justify-between sm:w-auto">
      <div class="brand-group min-w-0">
        <a
          href={getRelativeLocaleUrl(locale, "")}
          class="brand-title text-foreground hover:text-accent inline-block font-serif text-xl font-bold tracking-wide whitespace-nowrap transition-colors sm:text-2xl"
        >
          {site.title}
        </a>
        {sidebar && (
          <p class="brand-desc text-muted-foreground mt-2 hidden text-sm leading-relaxed">
            {site.description}
          </p>
        )}
      </div>

      {/* Mobile quick utility icons + menu button */}
      <div class="flex items-center gap-1 sm:hidden">
        {features.search !== false && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "search")}
            class:list={[
              "hover:bg-surface inline-flex size-10 items-center justify-center rounded-sm transition-colors",
              isActive("/search")
                ? "bg-accent-soft text-accent"
                : "text-foreground",
            ]}
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <IconSearch class="size-5" />
          </LinkButton>
        )}
        {features.lightAndDarkMode && (
          <button
            type="button"
            class="theme-toggle-btn text-foreground hover:bg-surface hover:text-accent relative inline-flex size-10 items-center justify-center rounded-sm transition-colors"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute size-5 scale-100 rotate-0 transition-transform dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute size-5 scale-0 rotate-90 transition-transform dark:scale-100 dark:rotate-0" />
          </button>
        )}
        <button
          id="menu-btn"
          type="button"
          class="text-foreground hover:bg-surface hover:text-accent inline-flex size-10 items-center justify-center rounded-sm transition-colors"
          aria-label={t.a11y.openMenu}
          aria-expanded="false"
          aria-controls="nav-menu"
          data-label-open={t.a11y.openMenu}
          data-label-close={t.a11y.closeMenu}
        >
          <IconX id="close-icon" class="hidden size-5" />
          <IconMenuDeep id="menu-icon" class="size-5" />
        </button>
      </div>
    </div>

    <nav
      id="nav-menu"
      aria-label="主导航"
      class="nav-menu mt-3 hidden w-full sm:mt-0 sm:flex sm:w-auto sm:items-center sm:gap-5"
    >
      <ul
        id="menu-items"
        class="border-border bg-surface flex flex-col rounded-sm border p-1.5 sm:flex-row sm:items-center sm:gap-5 sm:border-0 sm:bg-transparent sm:p-0"
      >
        {navLinks.map(({ href, label, path }) => (
          <li>
            <a
              href={href}
              class:list={[
                "nav-link hover:text-accent block rounded-sm px-3 py-2.5 text-sm font-medium transition-colors sm:px-0 sm:py-1 sm:text-[0.9375rem]",
                isActive(path)
                  ? "active-nav bg-accent-soft/70 sm:bg-transparent"
                  : "text-foreground",
              ]}
            >
              <span class="nav-label">{label}</span>
            </a>
          </li>
        ))}
        {features.showArchives && (
          <li class="sm:hidden">
            <a
              href={getRelativeLocaleUrl(locale, "archives")}
              class:list={[
                "nav-link hover:text-accent block rounded-sm px-3 py-2.5 text-sm font-medium transition-colors",
                isActive("/archives") || isActive("/tags")
                  ? "active-nav bg-accent-soft/70"
                  : "text-foreground",
              ]}
            >
              <span class="nav-label">archives.</span>
            </a>
          </li>
        )}
      </ul>

      {/* Desktop utility icons */}
      <div class="nav-utilities hidden items-center gap-1 sm:flex">
        {features.showArchives && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "archives")}
            class:list={[
              "inline-flex size-9 items-center justify-center rounded-sm border transition-colors",
              isActive("/archives") || isActive("/tags")
                ? "border-accent/40 bg-accent-soft text-accent"
                : "text-foreground hover:border-border hover:bg-surface hover:text-accent border-transparent",
            ]}
            title={t.nav.archives}
            aria-label={t.nav.archives}
          >
            <IconArchive class="size-5" />
          </LinkButton>
        )}
        {features.search !== false && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "search")}
            class:list={[
              "inline-flex size-9 items-center justify-center rounded-sm border transition-colors",
              isActive("/search")
                ? "border-accent/40 bg-accent-soft text-accent"
                : "text-foreground hover:border-border hover:bg-surface hover:text-accent border-transparent",
            ]}
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <IconSearch class="size-5" />
          </LinkButton>
        )}
        {features.lightAndDarkMode && (
          <button
            id="theme-btn"
            type="button"
            class="theme-toggle-btn text-foreground hover:border-border hover:bg-surface hover:text-accent relative inline-flex size-9 items-center justify-center rounded-sm border border-transparent transition-colors"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute size-5 scale-100 rotate-0 transition-transform dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute size-5 scale-0 rotate-90 transition-transform dark:scale-100 dark:rotate-0" />
          </button>
        )}
      </div>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const navMenu = document.querySelector("#nav-menu");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !navMenu || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      navMenu.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          { once: true }
        );
        target.focus();
        target.scrollIntoView({ behavior: "smooth" });
      }
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>

<style>
  .site-header {
    font-family: var(--font-serif);
  }

  .brand-desc {
    font-family: var(--font-app);
  }

  .nav-label {
    position: relative;
    display: inline-block;
  }

  .nav-label::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.2em;
    width: 100%;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 200ms ease-out;
    pointer-events: none;
  }

  a.active-nav > .nav-label::after,
  a:hover > .nav-label::after,
  a:focus-visible > .nav-label::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-label::after {
      transition: none;
    }
  }

  /* Desktop homepage vertical Nordic rail */
  @media (min-width: 66rem) {
    .home-sidebar-header {
      padding: 0;
    }

    .home-sidebar-header .header-inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 0 0 1.75rem;
      border-bottom: 0;
    }

    .home-sidebar-header .header-bar {
      width: 100%;
      margin-bottom: 1.75rem;
    }

    .home-sidebar-header .brand-title {
      font-size: 1.625rem;
      line-height: 1.3;
    }

    .home-sidebar-header .brand-desc {
      display: block;
    }

    .home-sidebar-header .nav-menu {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      gap: 1.5rem;
    }

    .home-sidebar-header #menu-items {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      gap: 0.25rem;
      border: 0;
      background: transparent;
      padding: 0;
    }

    .home-sidebar-header #menu-items > li {
      width: 100%;
    }

    .home-sidebar-header .nav-link {
      padding: 0.375rem 0;
      font-size: 1rem;
    }

    .home-sidebar-header .nav-utilities {
      display: flex;
      gap: 0.5rem;
      padding-top: 0.25rem;
    }
  }
</style>
