---
export interface Props {
  name: string;
  blog: {
    title?: string;
    url: string;
  };
}

const { name, blog } = Astro.props;

let hostname = blog.url;
try {
  hostname = new URL(blog.url).hostname.replace(/^www\./, "");
} catch {
  hostname = blog.url;
}
---

<li>
  <a
    href={blog.url}
    target="_blank"
    rel="noopener noreferrer"
    class="group border-border bg-background hover:border-accent hover:bg-surface flex h-full flex-col justify-between gap-2 rounded-sm border p-4 transition-colors"
  >
    <div>
      <div class="text-foreground group-hover:text-accent font-serif text-base font-bold transition-colors">
        {blog.title ?? name}
      </div>
      {blog.title && (
        <div class="text-muted-foreground mt-0.5 text-xs">{name}</div>
      )}
    </div>
    <div class="text-muted-foreground group-hover:text-accent truncate font-mono text-xs transition-colors">
      {hostname} ↗
    </div>
  </a>
</li>
