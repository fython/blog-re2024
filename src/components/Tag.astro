---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    class:list={[
      "border-border bg-surface text-muted-foreground inline-flex items-center gap-1 rounded-sm border transition-colors",
      "hover:border-accent hover:bg-accent-soft hover:text-accent",
      size === "sm" ? "px-2.5 py-1 text-xs" : "px-3 py-1.5 text-sm",
    ]}
  >
    <IconHash
      class:list={[
        "shrink-0 opacity-70",
        size === "lg" ? "size-3.5" : "size-3",
      ]}
    />
    <span>{tagName}</span>
  </a>
</li>
