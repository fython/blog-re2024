---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import CCLicenses from "./CCLicenses.astro";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class={`app-layout ${noMarginTop ? "" : "mt-auto"}`}>
  <Hr noPadding />
  <div
    class="flex flex-col items-center justify-between gap-3 py-6 sm:flex-row-reverse sm:py-5"
  >
    <Socials />
    <div
      class="text-muted-foreground flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center text-xs leading-relaxed sm:justify-start"
    >
      <span>
        Copyright &#169; {currentYear}
        <span property="cc:attributionName">烧饼</span>
      </span>
      <span aria-hidden="true" class="text-border-strong">/</span>
      <span class="inline-flex items-center gap-1">
        内容以 <CCLicenses /> 协议发布
      </span>
    </div>
  </div>
</footer>
